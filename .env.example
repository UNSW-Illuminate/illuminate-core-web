# Admin dashboard credentials and session signing secret.
#
# In development these may be omitted — the app falls back to admin / admin with
# a development signing secret. In production all three are REQUIRED: without
# them the login route returns 503 and /admin stays locked, rather than falling
# back to defaults that are public in this repository.
#
# Generate a secret with:  openssl rand -hex 32
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=
