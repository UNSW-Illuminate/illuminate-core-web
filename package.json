    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.9"
